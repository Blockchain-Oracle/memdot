# Portaldot V3 testnet
PORTALDOT_WSS=wss://test-node-v3.portaldot.dev
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev

# Relayer and keeper signing account (sr25519, testnet only). Generate with `pnpm --filter @memdot/chain keygen`.
SIGNER_MNEMONIC=

# Local Postgres from deploy/compose.dev.yml
DATABASE_URL=postgres://memdot:memdot@localhost:5434/memdot

# API (apps/api). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
API_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3100
# WebAuthn relying party: memdot.xyz in production so passkeys work on app., docs. and api.
RP_ID=localhost
# Production only: share the session cookie between app. and api.
# COOKIE_DOMAIN=memdot.xyz
# Production only: the reverse proxy's network, so rate limits see the real client address.
# TRUSTED_PROXIES=10.0.1.0/24
# Where the CID gateway keeps ciphertext it fetched from the chain.
# GATEWAY_CACHE_DIR=.cache/gateway

# Worker (apps/worker)
# Below this free balance new sponsored stores pause; renewals continue.
LOW_BALANCE_TPOT=2
# Ops alerts (low balance, renewal at risk, lost items) to a Discord channel.
# DISCORD_ALERT_WEBHOOK_URL=
# MemDotRegistry address once deployed; the indexer follows its logs.
# REGISTRY_ADDRESS=

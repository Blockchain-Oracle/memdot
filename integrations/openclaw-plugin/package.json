{
  "name": "@memdot/openclaw-plugin",
  "version": "0.1.0",
  "description": "Long-term memory for coding agents: encrypted on your device, stored on Portaldot V3, and yours to move or revoke.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./core/openclaw.mjs",
  "exports": {
    ".": {
      "import": "./core/openclaw.mjs"
    }
  },
  "repository": "https://github.com/Blockchain-Oracle/memdot",
  "keywords": [
    "memory",
    "coding-agents",
    "encrypted",
    "portaldot",
    "mcp"
  ],
  "openclaw": {
    "extensions": [
      "./core/openclaw.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.4.24",
      "minGatewayVersion": "2026.4.24"
    }
  }
}

{
  "name": "zapier-memdot",
  "version": "0.1.0",
  "private": true,
  "description": "MemDot for Zapier: long-term memory on Portaldot V3.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf ./dist ./build && tsc",
    "_zapier-build": "rimraf ./dist ./build && tsc",
    "typecheck": "tsc --noEmit",
    "validate": "zapier-platform validate --without-style"
  },
  "dependencies": {
    "zapier-platform-core": "19.3.0"
  },
  "devDependencies": {
    "rimraf": "5.0.10",
    "typescript": "5.6.2",
    "zapier-platform-cli": "19.3.0"
  }
}

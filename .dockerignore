# Secrets and local notes never enter a build context.
.env
.env.*
!.env.example
.claude
context
refs
.firecrawl

# Rebuilt inside the image.
**/node_modules
**/dist
**/.next
**/.turbo
**/.cache
**/*.tsbuildinfo

packages/chain/.papi/descriptors/generated.json

# Not needed to build any service.
.git
.github
.changeset
assets
docs
examples
python
skills
# The plugins aren't part of a service, except that the web image serves Kimi's as a zip, and pnpm
# wants every workspace package's manifest to be there.
integrations/*
!integrations/kimi-plugin
!integrations/agent-plugin-core
integrations/agent-plugin-core/*
!integrations/agent-plugin-core/package.json
packages/contracts/cache
packages/contracts/lib
packages/contracts/out
packages/contracts/test
**/Dockerfile

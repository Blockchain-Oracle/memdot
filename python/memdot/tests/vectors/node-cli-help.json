  "name": "memdot",
  "description": "Encrypted storage and agent memory on Portaldot V3.",
  "arguments": [],
  "options": [
    {
      "flags": "-v, --version",
      "description": "this CLI's version"
    },
    {
      "flags": "--agent",
      "description": "answer as one JSON envelope on stdout, for agents and scripts"
    },
    {
      "flags": "--json",
      "description": "the same as --agent"
    },
    {
      "flags": "-o, --output <mode>",
      "description": "how to answer",
      "choices": [
        "text",
        "json",
        "table",
        "quiet"
      ],
      "env": "MEMDOT_OUTPUT"
    },
    {
      "flags": "--api-key <key>",
      "description": "use this key (or MEMDOT_API_KEY)"
    },
    {
      "flags": "--api-url <url>",
      "description": "use this API (or MEMDOT_API_URL)"
    },
    {
      "flags": "-n, --namespace <id>",
      "description": "which namespace (or MEMDOT_NAMESPACE)"
    },
    {
      "flags": "-u, --user-id <id>",
      "description": "who this is about (or MEMDOT_USER_ID)"
    },
    {
      "flags": "--agent-id <id>",
      "description": "which agent this belongs to (or MEMDOT_AGENT_ID)"
    },
    {
      "flags": "--run-id <id>",
      "description": "which session or run (or MEMDOT_RUN_ID)"
    }
  ],
  "subcommands": [
    {
      "name": "add",
      "description": "Remember something",
      "arguments": [
        {
          "name": "text",
          "required": false,
          "description": "what to remember; or pipe it in"
        }
      ],
      "options": [
        {
          "flags": "--messages <json>",
          "description": "a conversation, as a JSON array of {role, content}"
        },
        {
          "flags": "-f, --file <path>",
          "description": "read the conversation from a JSON file"
        },
        {
          "flags": "-m, --metadata <json>",
          "description": "metadata to keep with it"
        },
        {
          "flags": "--no-infer",
          "description": "store it exactly as written, without a model"
        },
        {
          "flags": "--procedural",
          "description": "keep this as an agent's working record"
        },
        {
          "flags": "--immutable",
          "description": "never let it change"
        },
        {
          "flags": "--expires <date>",
          "description": "when it stops counting (YYYY-MM-DD)"
        },
        {
          "flags": "--timestamp <time>",
          "description": "when it happened (ISO time or unix seconds)"
        },
        {
          "flags": "--prompt <text>",
          "description": "custom instructions, for this call only"
        },
        {
          "flags": "--categories <json>",
          "description": "categories to file under, as a JSON array of {name, description}"
        },
        {
          "flags": "--idempotency-key <key>",
          "description": "sent again with the same key, it isn't saved twice"
        },
        {
          "flags": "--wait-chain",
          "description": "wait until it's finalized on Portaldot V3"
        },
        {
          "flags": "--no-wait",
          "description": "return at once with an event to follow"
        }
      ]
    },

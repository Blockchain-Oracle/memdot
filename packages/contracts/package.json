{
  "name": "@memdot/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "MemDot registry contract (Solidity on Portaldot V3 Revive) and its typed client.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "forge:build": "forge build",
    "forge:test": "forge test",
    "abi": "forge build && tsx scripts/export-abi.ts",
    "check-precompiles": "tsx scripts/check-precompiles.ts",
    "typecheck": "tsc -p tsconfig.json",
    "deploy:registry": "forge build && tsx scripts/deploy.ts",
    "signing-vectors": "tsx scripts/signing-vectors.ts"
  },
  "dependencies": {
    "@memdot/chain": "workspace:*",
    "@memdot/config": "workspace:*",
    "@polkadot-labs/hdkd": "^0.0.32",
    "@polkadot-labs/hdkd-helpers": "^0.0.34",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "tsdown": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src/MemDotRegistry.sol",
    "src/ISystem.sol"
  ]
}

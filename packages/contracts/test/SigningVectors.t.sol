pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {MemDotRegistry} from "../src/MemDotRegistry.sol";

/// The TypeScript client (src/signing.ts) and the contract must agree byte for byte on what an
/// owner signs. test/signing-vectors.json is generated by scripts/signing-vectors.ts.
contract SigningVectorsTest is Test {
    function test_typescriptAndSolidityAgreeOnSignedBytes() public {
        string memory json = vm.readFile("test/signing-vectors.json");
        address registryAddr = vm.parseJsonAddress(json, ".registry");
        vm.chainId(vm.parseJsonUint(json, ".chainId"));
        vm.etch(registryAddr, address(new MemDotRegistry()).code);
        MemDotRegistry registry = MemDotRegistry(registryAddr);

        bytes32 salt = vm.parseJsonBytes32(json, ".salt");
        MemDotRegistry.SpaceMode mode = MemDotRegistry.SpaceMode(vm.parseJsonUint(json, ".mode"));
        bytes32 action = keccak256(abi.encode("createSpace", salt, mode));
        assertEq(action, vm.parseJsonBytes32(json, ".actionHash"));

        bytes memory message = registry.signingMessage(
            vm.parseJsonBytes32(json, ".owner"), uint64(vm.parseJsonUint(json, ".nonce")), action
        );
        assertEq(keccak256(message), vm.parseJsonBytes32(json, ".messageHash"));
    }
}

{
  "name": "@memdot/langchain",
  "version": "0.1.0",
  "private": true,
  "description": "Long-term memory for LangChain and LangGraph: encrypted, on Portaldot V3.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "dev": "tsdown src/index.ts --dts --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@memdot/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph-checkpoint": "^1.2",
    "langchain": "^1.6",
    "zod": "^3.25.76 || ^4"
  },
  "devDependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@memdot/config": "workspace:*",
    "@types/node": "catalog:",
    "langchain": "1.6.0",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}

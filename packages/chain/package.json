{
  "name": "@memdot/chain",
  "version": "0.0.0",
  "private": true,
  "description": "Portaldot V3 client for MemDot: TransactionStorage store, renew and bitswap reads.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "dev": "tsdown src/index.ts --dts --watch",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "tsx scripts/probe.ts",
    "keygen": "tsx scripts/keygen.ts",
    "demo": "tsx scripts/demo.ts",
    "postinstall": "papi"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@memdot/config": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-labs/hdkd": "^0.0.32",
    "@polkadot-labs/hdkd-helpers": "^0.0.34",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "polkadot-api": "^3.3.0",
    "rxjs": "^7.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}

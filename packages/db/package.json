{
  "name": "@memdot/db",
  "version": "0.0.0",
  "private": true,
  "description": "MemDot Postgres schema (Drizzle), migrations and the database client.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "dev": "tsdown src/index.ts --dts --watch",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@memdot/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}

{
  "name": "@memdot/memory-server",
  "version": "0.0.0",
  "private": true,
  "description": "The server side of Assisted memory, shared by the API and the worker: its keys, its index, and how memories reach the chain.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "dev": "tsdown src/index.ts --dts --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@memdot/chain": "workspace:*",
    "@memdot/config": "workspace:*",
    "@memdot/crypto": "workspace:*",
    "@memdot/db": "workspace:*",
    "@memdot/jobs": "workspace:*",
    "@memdot/memory-engine": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "drizzle-orm": "0.45.4",
    "pg-boss": "^12.38.0",
    "zod": "catalog:",
    "ai": "^7.0.159"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "tsx": "^4.23.15"
  }
}

{
  "name": "@memdot/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "MemDot for TypeScript: encrypted storage on Portaldot V3 for apps, files and agent memory.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./credentials": {
      "types": "./dist/credentials.d.mts",
      "import": "./dist/credentials.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/credentials.ts --dts",
    "dev": "tsdown src/index.ts src/credentials.ts --dts --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "generate:check": "openapi-typescript openapi.json -o src/schema.ts --check",
    "journey": "tsx scripts/journey-s05.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:self-signed": "tsx scripts/self-signed-demo.ts",
    "journey:memory": "tsx scripts/journey-s08.ts",
    "smoke:memory": "tsx scripts/memory-smoke.ts",
    "seed:memory": "tsx scripts/seed-memory.ts",
    "live:memory": "tsx scripts/memory-live.ts",
    "journey:pro": "tsx scripts/journey-s13.ts",
    "vectors:python": "tsx scripts/python-vectors.ts",
    "journey:python": "tsx scripts/journey-s10.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@memdot/chain": "workspace:*",
    "@memdot/config": "workspace:*",
    "@memdot/contracts": "workspace:*",
    "@memdot/crypto": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@talismn/siws": "^2.1.0",
    "openapi-fetch": "^0.17.0",
    "viem": "^2.57.13",
    "@memdot/memory-engine": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "@types/node": "catalog:",
    "openapi-typescript": "7.13.0",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
